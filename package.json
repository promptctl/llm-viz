    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
