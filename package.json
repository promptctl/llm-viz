{
  "name": "llm-viz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A transformer you can stand inside — interactive 3D residual-stream visualization",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5173 --strictPort",
